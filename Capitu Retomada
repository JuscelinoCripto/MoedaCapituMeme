pragma solidity ^0.8.0;

import "@openzeppelin/contracts/token/ERC20/ERC20.sol";
import "@openzeppelin/contracts/token/ERC20/extensions/ERC20Burnable.sol";
import "@openzeppelin/contracts/access/Ownable.sol";
import "@openzeppelin/contracts/security/Pausable.sol";
import "@openzeppelin/contracts/utils/math/SafeMath.sol"; // Importado para cálculos seguros

contract CapituCoin is ERC20, ERC20Burnable, Ownable, Pausable {
    using SafeMath for uint256; // Usando SafeMath para operações matemáticas seguras

    // --- Variáveis de Tokenomics ---
    // 10_000_000_000 é 10 bilhões. Multiplicamos por 10**18 para considerar os 18 decimais do token.
    uint256 public constant INITIAL_SUPPLY = 10_000_000_000 * 10**18; // 10 bilhões de tokens iniciais

    // 20_000_000_000 é 20 bilhões. Multiplicamos por 10**18 para considerar os 18 decimais do token.
    uint256 public constant MAX_SUPPLY = 20_000_000_000 * 10**18; // Limite de fornecimento máximo (20 bilhões)

    // --- Variáveis de Staking e Recompensas ---
    uint256 public rewardRate = 100; // Taxa de recompensa em base anual (1% = 100/10_000)
                                      // Multiplicador: 1% = 100, 0.5% = 50. Para porcentagem, divida por 10_000.
    uint256 public constant REWARD_RATE_DENOMINATOR = 10_000; // Para calcular porcentagens (100 / 10_000 = 1%)

    mapping(address => uint256) public stakedBalances;
    mapping(address => uint256) public stakingStart; // Último timestamp em que as recompensas foram calculadas/reiniciadas
    mapping(address => uint256) public pendingRewards; // Recompensas acumuladas não resgatadas
    uint256 public totalStaked;

    // --- Variáveis de Liberação Mensal ---
    // Ajustado para 10 milhões para ser proporcional à nova escala de bilhões
    uint256 public monthlyReleaseAmount = 10_000_000 * 10**18; // Valor de liberação mensal (10 milhões de CAPITU)
    uint256 public lastMonthlyReleaseTime; // Último timestamp da liberação mensal

    // Arrays para distribuição inicial, devem ser preenchidos no construtor ou por função onlyOwner (com cautela)
    address[] private _initialHolders;
    uint256[] private _initialAllocations;

    // --- Eventos ---
    event TokensStaked(address indexed user, uint256 amount);
    event TokensUnstaked(address indexed user, uint256 amount);
    event RewardsClaimed(address indexed user, uint256 amount);
    event MonthlyTokensReleased(uint256 amount);
    event TokensBurned(address indexed burner, uint256 amount); // Adicionado 'burner' para rastreamento
    event RewardRateUpdated(uint256 oldRate, uint256 newRate); // Adicionado 'oldRate' para rastreamento
    event MonthlyReleaseExecuted(address indexed executor, uint256 amountReleased); // Adicionado 'amountReleased'

    // --- Construtor ---
    constructor(
        address owner,
        address[] memory initialHolders_,
        uint256[] memory initialAllocations_
    )
        ERC20("CapituCoin", "CAPITU")
        Ownable(owner)
    {
        // Garante que o número de detentores e alocações corresponda
        require(initialHolders_.length == initialAllocations_.length, "Initial holders and allocations mismatch");
        require(initialHolders_.length > 0, "Initial holders cannot be empty");

        // Verifica se a soma das alocações iniciais não excede a INITIAL_SUPPLY
        uint256 totalInitialAllocation = 0;
        for (uint256 i = 0; i < initialAllocations_.length; i++) {
            totalInitialAllocation = totalInitialAllocation.add(initialAllocations_[i]);
        }
        require(totalInitialAllocation <= INITIAL_SUPPLY, "Total initial allocation exceeds initial supply");

        _initialHolders = initialHolders_;
        _initialAllocations = initialAllocations_;

        // O owner já é definido pela inicialização de Ownable(owner). 'transferOwnership' é redundante aqui.
        lastMonthlyReleaseTime = block.timestamp;
        _mint(owner, INITIAL_SUPPLY); // Minta a quantidade inicial para o proprietário

        // Se houver uma lógica de distribuição inicial diferente da simplesmente mintar tudo para o owner
        // e depois distribuir, você precisaria adicionar essa lógica aqui ou em outra função.
        // O código atual mintará TUDO para o 'owner' e as alocações em _initialHolders serão distribuídas
        // APENAS com a função releaseMonthlyTokens (se INITIAL_SUPPLY for o total inicial e não o MAX_SUPPLY).
        // CUIDADO: Revise sua tokenomics sobre como a INITIAL_SUPPLY se relaciona com _initialHolders.
        // Se a intenção é que os _initialHolders recebam parte da INITIAL_SUPPLY, então _mint(owner, INITIAL_SUPPLY)
        // pode precisar ser ajustado ou substituído por _mint para cada initialHolder aqui.
    }

    // --- Funções de Staking ---
    function stakeTokens(uint256 amount) external whenNotPaused {
        require(amount > 0, "Amount must be greater than 0");
        require(balanceOf(msg.sender) >= amount, "Insufficient balance");

        _updateAccruedRewards(msg.sender); // Atualiza recompensas antes de alterar o saldo em stake

        _transfer(msg.sender, address(this), amount); // Transfere para o contrato
        stakedBalances[msg.sender] = stakedBalances[msg.sender].add(amount);
        // stakingStart[msg.sender] é atualizado em _updateAccruedRewards. Se for o primeiro stake, ele será 0.
        // Se não houver stake anterior, defina stakingStart:
        if (stakingStart[msg.sender] == 0) {
            stakingStart[msg.sender] = block.timestamp;
        }
        totalStaked = totalStaked.add(amount);

        emit TokensStaked(msg.sender, amount);
    }

    function unstakeTokens(uint256 amount) external whenNotPaused {
        require(amount > 0, "Amount must be greater than 0");
        require(stakedBalances[msg.sender] >= amount, "Insufficient staked balance");

        _updateAccruedRewards(msg.sender); // Atualiza recompensas antes de alterar o saldo em stake

        stakedBalances[msg.sender] = stakedBalances[msg.sender].sub(amount);
        totalStaked = totalStaked.sub(amount);
        _transfer(address(this), msg.sender, amount); // Transfere de volta para o usuário

        emit TokensUnstaked(msg.sender, amount);
    }

    // --- Funções de Recompensas ---
    function claimRewards() public whenNotPaused {
        _updateAccruedRewards(msg.sender); // Garante que todas as recompensas acumuladas sejam calculadas
        uint256 rewardsToClaim = pendingRewards[msg.sender];
        require(rewardsToClaim > 0, "No rewards available to claim");

        pendingRewards[msg.sender] = 0; // Zera as recompensas pendentes
        // stakingStart[msg.sender] é reiniciado em _updateAccruedRewards

        // Verifica se a mintagem não excederá o fornecimento máximo
        require(totalSupply().add(rewardsToClaim) <= MAX_SUPPLY, "Exceeds maximum supply for rewards");

        _mint(msg.sender, rewardsToClaim); // Minta as recompensas
        emit RewardsClaimed(msg.sender, rewardsToClaim);
    }

    // Função interna para calcular e acumular recompensas
    function _updateAccruedRewards(address staker) internal {
        if (stakedBalances[staker] > 0 && block.timestamp > stakingStart[staker]) {
            uint256 timeElapsed = block.timestamp.sub(stakingStart[staker]);
            // Recompensa = (saldo_em_stake * taxa_de_recompensa * tempo_decorrido) / (segundos_no_ano * denominador_da_taxa)
            // Usamos 1e18 para garantir precisão e depois dividimos para o resultado final
            uint256 newRewards = stakedBalances[staker]
                .mul(rewardRate)
                .mul(timeElapsed)
                .div(365 days)
                .div(REWARD_RATE_DENOMINATOR);

            if (newRewards > 0) {
                pendingRewards[staker] = pendingRewards[staker].add(newRewards);
            }
            stakingStart[staker] = block.timestamp; // Reseta o tempo de início para o próximo cálculo
        }
    }

    // Função view para que qualquer um possa verificar suas recompensas potenciais (incluindo as não atualizadas)
    function calculateRewards(address staker) public view returns (uint256) {
        uint256 currentUnclaimedRewards = 0;
        if (stakedBalances[staker] > 0 && block.timestamp > stakingStart[staker]) {
            uint256 timeElapsed = block.timestamp.sub(stakingStart[staker]);
            currentUnclaimedRewards = stakedBalances[staker]
                .mul(rewardRate)
                .mul(timeElapsed)
                .div(365 days)
                .div(REWARD_RATE_DENOMINATOR);
        }
        return pendingRewards[staker].add(currentUnclaimedRewards);
    }

    // --- Funções de Liberação Mensal ---
    function releaseMonthlyTokens() external onlyOwner whenNotPaused {
        // Verifica se o tempo mínimo para a próxima liberação mensal passou
        require(block.timestamp >= lastMonthlyReleaseTime.add(30 days), "Monthly tokens already released or not due yet");
        // Verifica se a mintagem não excederá o fornecimento máximo
        require(totalSupply().add(monthlyReleaseAmount) <= MAX_SUPPLY, "Exceeds maximum supply for monthly release");

        uint256 totalAllocationSum = 0; // Para somar as alocações distribuídas

        // Garante que os arrays estejam preenchidos
        require(_initialHolders.length > 0, "No initial holders set for monthly release");

        for (uint256 i = 0; i < _initialHolders.length; i++) {
            // Calcula a alocação proporcional para cada detentor inicial
            // (alocacao_inicial_do_detentor * monthlyReleaseAmount) / INITIAL_SUPPLY
            // Isso assume que as _initialAllocations são proporções da INITIAL_SUPPLY.
            // Se as _initialAllocations já são valores absolutos a serem distribuídos, a lógica muda.
            // Cuidado com a divisão por zero se INITIAL_SUPPLY for 0 (embora improvável com seu construtor).
            uint256 allocation = _initialAllocations[i].mul(monthlyReleaseAmount).div(INITIAL_SUPPLY);
            _mint(_initialHolders[i], allocation);
            totalAllocationSum = totalAllocationSum.add(allocation);
        }

        // Garante que a soma das alocações distribua o valor exato do monthlyReleaseAmount
        // Pode haver pequenas diferenças devido a arredondamento em divisões. Considere tolerância.
        // Ou, se a soma for muito grande, o último recebedor pode pegar o restante.
        require(totalAllocationSum == monthlyReleaseAmount, "Token distribution mismatch in monthly release");

        lastMonthlyReleaseTime = block.timestamp; // Atualiza o timestamp da última liberação

        emit MonthlyTokensReleased(monthlyReleaseAmount);
        emit MonthlyReleaseExecuted(msg.sender, monthlyReleaseAmount);
    }

    // Função para atualizar o valor da liberação mensal (apenas o proprietário)
    function setMonthlyReleaseAmount(uint256 newAmount) external onlyOwner {
        require(newAmount > 0, "Monthly release amount must be greater than 0");
        monthlyReleaseAmount = newAmount;
    }


    // --- Funções de Queima (Burn) ---
    function burnTokens(uint256 amount) external onlyOwner {
        require(amount > 0, "Amount to burn must be greater than 0");
        _burn(msg.sender, amount); // Queima tokens do saldo do proprietário
        emit TokensBurned(msg.sender, amount);
    }

    // --- Funções de Administração (Owner Only) ---
    function updateRewardRate(uint256 newRate) external onlyOwner {
        require(newRate <= 10000, "Reward rate cannot exceed 100%"); // Limite razoável para a taxa (100% = 10000)
        emit RewardRateUpdated(rewardRate, newRate); // Emite o valor antigo e o novo
        rewardRate = newRate;
    }

    function pause() external onlyOwner {
        _pause();
    }

    function unpause() external onlyOwner {
        _unpause();
    }
}
